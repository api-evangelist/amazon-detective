            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Gets information on the data source package history for an account."
        },
        {
          "info": {
            "name": "Amazon Detective Update Datasource Packages",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.detective.{region}.amazonaws.com/graph/datasources/update",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
